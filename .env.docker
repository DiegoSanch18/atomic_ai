# ==============================================================================
# Variables de Entorno para Docker Compose (Atomic AI Proxy + Inference Gateway)
# ==============================================================================

# Configuración del Gateway (:8081)
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8081

# Endpoint donde corre llama-server (usualmente en la máquina host con CUDA o Vulkan)
# En Windows/Mac Docker Desktop y Linux con host-gateway: http://host.docker.internal:8080
DEFAULT_LOCAL_BACKEND=http://host.docker.internal:8080
DESKTOP_BACKEND_URL=http://host.docker.internal:8080
LAPTOP_BACKEND_URL=http://host.docker.internal:8080
TRUENAS_BACKEND_URL=http://truenas.local:8080

# Configuración del Proxy Cognitivo Atomic AI (:8000)
# Apunta internamente al servicio del gateway en la red docker 'ai-network'
UPSTREAM_BASE_URL=http://gateway:8081
UPSTREAM_API_KEY=llamalaunch
UPSTREAM_MODEL=gemma-4-e2b

# Parámetros cognitivos y SLM
MAX_DECOMPOSITION_DEPTH=1
MAX_TOOL_ROUNDS_PER_PHASE=25
SESSION_TTL_SECONDS=1800
MAX_SESSIONS=200
EXPOSE_REASONING_CONTENT=true
REQUEST_TIMEOUT_SECONDS=180.0
PROMPT_PROFILE=slm
